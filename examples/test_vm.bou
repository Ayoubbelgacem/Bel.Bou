# ============================================
# 18. STATISTIQUES
# ============================================
ikteb("--- 18. STATISTIQUES ---");

dallel miin(tab) {
    khdem min_val = tab[0];
    i men 1 7ata len(tab)-1 a3mel {
        ken tab[i] < min_val a3mel {
            min_val = tab[i];
        }
    }
    rejje min_val;
}

# ✅ Renommage pour éviter le conflit avec built-in max
dallel valeur_max(tab) {
    khdem max_val = tab[0];
    i men 1 7ata len(tab)-1 a3mel {
        ken tab[i] > max_val a3mel {
            max_val = tab[i];
        }
    }
    rejje max_val;
}

dallel moyenne(tab) {
    khdem sum = 0;
    i men 0 7ata len(tab)-1 a3mel {
        sum = sum + tab[i];
    }
    rejje sum / len(tab);
}

khdem stats = [3, 7, 2, 9, 5, 1, 8, 4, 6];
ikteb("Statistiques: " + stats);
ikteb("Min: " + miin(stats));
ikteb("Max: " + valeur_max(stats));   # ✅ Appel corrigé
ikteb("Moyenne: " + moyenne(stats));
ikteb("");