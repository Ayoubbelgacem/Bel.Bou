class Animal {
    hetha.name = "Unknown";
    dallel set_name(n) {
        hetha.name = n;
    }
}

class Dog toroth Animal {
    jdid(name) {
        hetha.name = name;
    }
    dallel bark() {
        ikteb(hetha.name + " says: Woof!");
    }
}

khdem dog = new Dog("Rex");
dog.bark();

