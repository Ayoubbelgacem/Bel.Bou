{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Bou.Bel",
    "scopeName": "source.boubel",
    "patterns": [
        {"include": "#comments"},
        {"include": "#keywords"},
        {"include": "#strings"},
        {"include": "#numbers"},
        {"include": "#functions"},
        {"include": "#operators"},
        {"include": "#variables"}
    ],
    "repository": {
        "comments": {
            "patterns": [
                {"name": "comment.line.number-sign.boubel", "match": "#.*$"},
                {"name": "comment.block.boubel", "begin": "/\\*", "end": "\\*/"}
            ]
        },
        "keywords": {
            "patterns": [
                {"name": "keyword.control.boubel", "match": "\\b(ken|sinon|sinon_ken|a3mel|tawa|men|7ata|rejje|dallel|khdem|s7i7|ghalet|toroth|jdid|hetha|7awel|ebsed|akhir|t7at|ktif|kaml|jib)\\b"},
                {"name": "keyword.other.boubel", "match": "\\b(ikteb|iqra_mlf|ikteb_fi_mlf)\\b"}
            ]
        },
        "strings": {
            "patterns": [
                {"name": "string.quoted.double.boubel", "begin": "\"", "end": "\"", "patterns": [{"name": "constant.character.escape.boubel", "match": "\\\\."}]},
                {"name": "string.quoted.single.boubel", "begin": "'", "end": "'", "patterns": [{"name": "constant.character.escape.boubel", "match": "\\\\."}]}
            ]
        },
        "numbers": {
            "patterns": [
                {"name": "constant.numeric.boubel", "match": "\\b[0-9]+(\\.[0-9]+)?\\b"}
            ]
        },
        "functions": {
            "patterns": [
                {"name": "entity.name.function.boubel", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*(?=\\()"}
            ]
        },
        "operators": {
            "patterns": [
                {"name": "keyword.operator.boubel", "match": "(\\+|\\-|\\*|\\/|\\%|\\=|\\<|\\>|\\!|\\&|\\||\\?)"}
            ]
        },
        "variables": {
            "patterns": [
                {"name": "variable.other.boubel", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"}
            ]
        }
    }
}